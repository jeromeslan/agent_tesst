# ---------------------------------------------------------------------------
# Hybrid Algo-Trading PoC — variables d'environnement (exemple)
# Copier vers `.env` puis renseigner les clés.
# ---------------------------------------------------------------------------

# --- Base de données (TimescaleDB via docker-compose) -----------------------
DATABASE_URL=postgresql+asyncpg://trader:trader_secret@db:5432/trading
# Pour un run local SANS docker (fallback SQLite, utile pour dev/tests) :
# DATABASE_URL=sqlite+aiosqlite:///./trading.db

# --- Paires & timeframes ------------------------------------------------------
# Paires au format Kraken WS v2 "BASE/QUOTE"
TRADING_PAIRS=BTC/USD,ETH/USD,SOL/USD
# Timeframes Kraken supportés : 1, 5, 15, 30, 60, 240, 1440...
TRADING_TIMEFRAMES=1,5,15

# --- Mode d'exécution : FULL_AUTO | HITM --------------------------------------
EXECUTION_MODE=HITM
CONFIDENCE_THRESHOLD=70
# Notionnel virtuel par ordre (paper trading, en USD)
PAPER_NOTIONAL_USD=100.0
# Cadence d'analyse du pipeline (secondes)
PIPELINE_INTERVAL_SECONDS=60

# --- Kraken (API publique, pas de clé requise) --------------------------------
KRAKEN_REST_URL=https://api.kraken.com
KRAKEN_WS_URL=wss://ws.kraken.com/v2

# --- Agent LLM (appel RÉEL via SDK OpenAI — jamais mocké) --------------------
# Le SDK `openai` est utilisé avec une `base_url` configurable, ce qui permet
# d'utiliser indifféremment :
#   - OpenAI direct (défaut, modèle gpt-4o), ou
#   - tout gateway compatible OpenAI donnant accès au set de modèles arena.ai
#     (GPT, Claude, Gemini, Grok, Qwen, Kimi...) en renseignant LLM_BASE_URL
#     + LLM_MODEL + LLM_API_KEY correspondants.
LLM_ENABLED=true
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-votre-cle-ici
# Exemples de gateway OpenAI-compatible (à adapter à votre contrat arena.ai) :
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_BASE_URL=https://votre-gateway-arena.ai/v1
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1

# --- Backend ------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
